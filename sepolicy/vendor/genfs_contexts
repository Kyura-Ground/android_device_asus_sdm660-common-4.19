# Double tap to wake
genfscon proc /tpd_gesture														u:object_r:proc_tpd_gesture:s0

# kmsg
genfscon proc /last_kmsg                                                u:object_r:proc_last_kmsg:s0

# LED
genfscon sysfs /devices/platform/soc/800f000.qcom,spmi/spmi-0/spmi0-03/800f000.qcom,spmi:qcom,pm660l@3:qcom,leds@d000/leds                 u:object_r:sysfs_graphics:s0

# Power
genfscon sysfs /devices/virtual/graphics/fb0                    u:object_r:sysfs_graphics:s0
genfscon sysfs /devices/virtual/graphics/fb1                    u:object_r:sysfs_graphics:s0
genfscon sysfs /devices/virtual/graphics/fb2                    u:object_r:sysfs_graphics:s0
genfscon sysfs /devices/platform/soc/soc:qcom,gpubw             u:object_r:sysfs_devfreq:s0
genfscon sysfs /devices/platform/soc/soc:qcom,cpubw             u:object_r:sysfs_devfreq:s0

# DeviceSettings
genfscon sysfs /devices/virtual/graphics/fb0/measured_fps                                                                                            u:object_r:sysfs_fpsinfo:s0
genfscon sysfs /class/graphics/fb0/measured_fps                                                                                                      u:object_r:sysfs_fpsinfo:s0

# wakeup nodes
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/active_count u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/active_time_ms u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/event_count u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/expire_count u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/last_change_ms u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/max_time_ms u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/name u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/prevent_suspend_time_ms u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/total_time_ms u:object_r:sysfs_wakeup:s0
genfscon sysfs /devices/virtual/wakeup/wakeup[0-101][0-101]/wakeup_count u:object_r:sysfs_wakeup:s0

# Scheduler parameters
genfscon proc /sys/kernel/sched_boost           u:object_r:proc_sched:s0
genfscon proc /sys/kernel/sched_upmigrate       u:object_r:proc_sched:s0
genfscon proc /sys/kernel/sched_downmigrate     u:object_r:proc_sched:s0

genfscon sysfs /block/zram0/disksize      u:object_r:sysfs_zram:s0
genfscon sysfs /block/zram0/comp_algorithm u:object_r:sysfs_zram:s0
genfscon sysfs /block/zram0/max_comp_streams u:object_r:sysfs_zram:s0

# Allow kernel to read persist partition
genfscon ext4 /persist u:object_r:persist_file:s0

# GPU - Adreno 5xx
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/devfreq/available_frequencies u:object_r:sysfs_gpu_freq:s0
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/devfreq/min_freq u:object_r:sysfs_gpu_freq:s0
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/devfreq/max_freq u:object_r:sysfs_gpu_freq:s0
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/devfreq/cur_freq u:object_r:sysfs_gpu_freq:s0
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/devfreq/available_governors u:object_r:sysfs_gpu_freq:s0
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/devfreq/governor u:object_r:sysfs_gpu_freq:s0
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_busy_percentage u:object_r:sysfs_gpu_freq:s0
genfscon sysfs /devices/platform/soc/5000000.qcom,kgsl-3d0/kgsl/kgsl-3d0/gpu_clock_stats u:object_r:sysfs_gpu_freq:s0

# Performance mode
#genfscon proc /sys/vm/drop_caches                 u:object_r:proc_drop_caches:s0
genfscon proc /sys/vm/vfs_cache_pressure          u:object_r:proc_vfs_cache_pressure:s0
genfscon proc /sys/kernel/sched_migration_cost_ns u:object_r:proc_sched:s0


