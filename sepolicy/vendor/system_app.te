allow system_app zygote:unix_stream_socket { getopt };

# Allow syste access to zram
allow system_app sysfs_zram:dir search;
allow system_app sysfs_zram:file r_file_perms;
allow system_app proc_pagetypeinfo:file { read open getattr };

allow system_app kcal_dev:dir search;
allow system_app kcal_dev:file rw_file_perms;
allow system_app sysfs_fpsinfo:file rw_file_perms;
allow system_app sysfs_graphics:dir search;
allow system_app sysfs_graphics:file rw_file_perms;

get_prop(system_app, vendor_bluetooth_prop)

allow system_app sysfs_leds:dir { search };

dontaudit system_app vendor_default_prop:file { open getattr map };

dontaudit system_app default_android_service:service_manager { find };

get_prop(system_app, qemu_hw_prop)

# system_app -> HAL binder calls
allow system_app hal_audio_default:binder { call };
allow system_app hal_camera_default:binder { call };
allow system_app hal_health_default:binder { call };
allow system_app hal_memtrack_default:binder { call };

# Разрешить чтение GPU
allow system_app sysfs_gpu_freq:file r_file_perms;
allow system_app sysfs_gpu_freq:dir search;

# Разрешить чтение/запись battery (bypass charge)
allow system_app sysfs_battery_supply:file rw_file_perms;
allow system_app sysfs_battery_supply:dir search;

# Разрешить чтение USB supply
allow system_app sysfs_usb_supply:file r_file_perms;
allow system_app sysfs_usb_supply:dir search;

allow system_app sysfs_kgsl_gpuclk:file rw_file_perms;
allow system_app sysfs_kgsl_gpuclk:dir search;
