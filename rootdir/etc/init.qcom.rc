# Copyright (c) 2009-2012, 2014-2021, The Linux Foundation. All rights reserved.
#
# ASUS X00TD / X01BD — init.qcom.rc
# Kernel 4.19, Android 15/16, SDM660/SDM636
# Tuned for FBE v1 + legacy Keymaster 3.0
# Migrated from SchedTune to UCLAMP

import /vendor/etc/init/hw/init.qcom.usb.rc
import /vendor/etc/init/hw/init.target.rc
import /vendor/etc/init/hw/init.asus.sdm660-common.rc
import /vendor/etc/init/hw/init.asus.X00TD.rc
import /vendor/etc/init/hw/init.asus.X01BD.rc
import /vendor/etc/init/hw/init.zram.rc
import /vendor/etc/init/hw/init.uclamp.rc


# ─────────────────────────────────────────────────────────────
# early-init
# ─────────────────────────────────────────────────────────────
on early-init
    mkdir /dev/cpuset 0750 system system
    mkdir /dev/cpuctl 0755 system system

    chown system graphics /sys/class/drm/card0/device/power/control

    chown root system /dev/kmsg
    chmod 0620 /dev/kmsg


# ─────────────────────────────────────────────────────────────
# init
# ─────────────────────────────────────────────────────────────
on init
    # ── cpuset sub-groups ──
    mkdir /dev/cpuset/foreground        0750 system system
    mkdir /dev/cpuset/background        0750 system system
    mkdir /dev/cpuset/system-background 0750 system system
    mkdir /dev/cpuset/top-app           0750 system system
    mkdir /dev/cpuset/restricted        0750 system system

    chmod 0664 /dev/cpuset/tasks
    chmod 0664 /dev/cpuset/foreground/tasks
    chmod 0664 /dev/cpuset/background/tasks
    chmod 0664 /dev/cpuset/system-background/tasks
    chmod 0664 /dev/cpuset/top-app/tasks
    chmod 0664 /dev/cpuset/restricted/tasks

    chmod 0664 /dev/cpuset/cgroup.procs
    chmod 0664 /dev/cpuset/foreground/cgroup.procs
    chmod 0664 /dev/cpuset/background/cgroup.procs
    chmod 0664 /dev/cpuset/system-background/cgroup.procs
    chmod 0664 /dev/cpuset/top-app/cgroup.procs
    chmod 0664 /dev/cpuset/restricted/cgroup.procs

    # ── cpuctl sub-groups for UCLAMP ──
    mkdir /dev/cpuctl/top-app           0755 system system
    mkdir /dev/cpuctl/foreground        0755 system system
    mkdir /dev/cpuctl/background        0755 system system
    mkdir /dev/cpuctl/system-background 0755 system system
    mkdir /dev/cpuctl/rt                0755 system system

    # cpuctl tasks permissions
    chown system system /dev/cpuctl/tasks
    chown system system /dev/cpuctl/top-app/tasks
    chown system system /dev/cpuctl/foreground/tasks
    chown system system /dev/cpuctl/background/tasks
    chown system system /dev/cpuctl/system-background/tasks
    chown system system /dev/cpuctl/rt/tasks

    chmod 0664 /dev/cpuctl/tasks
    chmod 0664 /dev/cpuctl/top-app/tasks
    chmod 0664 /dev/cpuctl/foreground/tasks
    chmod 0664 /dev/cpuctl/background/tasks
    chmod 0664 /dev/cpuctl/system-background/tasks
    chmod 0664 /dev/cpuctl/rt/tasks

    # cpuctl cgroup.procs permissions
    chown system system /dev/cpuctl/cgroup.procs
    chown system system /dev/cpuctl/top-app/cgroup.procs
    chown system system /dev/cpuctl/foreground/cgroup.procs
    chown system system /dev/cpuctl/background/cgroup.procs
    chown system system /dev/cpuctl/system-background/cgroup.procs
    chown system system /dev/cpuctl/rt/cgroup.procs

    chmod 0664 /dev/cpuctl/cgroup.procs
    chmod 0664 /dev/cpuctl/top-app/cgroup.procs
    chmod 0664 /dev/cpuctl/foreground/cgroup.procs
    chmod 0664 /dev/cpuctl/background/cgroup.procs
    chmod 0664 /dev/cpuctl/system-background/cgroup.procs
    chmod 0664 /dev/cpuctl/rt/cgroup.procs

    # cpuctl uclamp knobs — ownership
    chown system system /dev/cpuctl/uclamp.min
    chown system system /dev/cpuctl/uclamp.max
    chown system system /dev/cpuctl/uclamp.latency_sensitive

    chown system system /dev/cpuctl/top-app/uclamp.min
    chown system system /dev/cpuctl/top-app/uclamp.max
    chown system system /dev/cpuctl/top-app/uclamp.latency_sensitive

    chown system system /dev/cpuctl/foreground/uclamp.min
    chown system system /dev/cpuctl/foreground/uclamp.max
    chown system system /dev/cpuctl/foreground/uclamp.latency_sensitive

    chown system system /dev/cpuctl/background/uclamp.min
    chown system system /dev/cpuctl/background/uclamp.max
    chown system system /dev/cpuctl/background/uclamp.latency_sensitive

    chown system system /dev/cpuctl/system-background/uclamp.min
    chown system system /dev/cpuctl/system-background/uclamp.max
    chown system system /dev/cpuctl/system-background/uclamp.latency_sensitive

    chown system system /dev/cpuctl/rt/uclamp.min
    chown system system /dev/cpuctl/rt/uclamp.max
    chown system system /dev/cpuctl/rt/uclamp.latency_sensitive

    # cpuctl uclamp knobs — permissions
    chmod 0664 /dev/cpuctl/uclamp.min
    chmod 0664 /dev/cpuctl/uclamp.max
    chmod 0664 /dev/cpuctl/uclamp.latency_sensitive

    chmod 0664 /dev/cpuctl/top-app/uclamp.min
    chmod 0664 /dev/cpuctl/top-app/uclamp.max
    chmod 0664 /dev/cpuctl/top-app/uclamp.latency_sensitive

    chmod 0664 /dev/cpuctl/foreground/uclamp.min
    chmod 0664 /dev/cpuctl/foreground/uclamp.max
    chmod 0664 /dev/cpuctl/foreground/uclamp.latency_sensitive

    chmod 0664 /dev/cpuctl/background/uclamp.min
    chmod 0664 /dev/cpuctl/background/uclamp.max
    chmod 0664 /dev/cpuctl/background/uclamp.latency_sensitive

    chmod 0664 /dev/cpuctl/system-background/uclamp.min
    chmod 0664 /dev/cpuctl/system-background/uclamp.max
    chmod 0664 /dev/cpuctl/system-background/uclamp.latency_sensitive

    chmod 0664 /dev/cpuctl/rt/uclamp.min
    chmod 0664 /dev/cpuctl/rt/uclamp.max
    chmod 0664 /dev/cpuctl/rt/uclamp.latency_sensitive

    # ── Memory cgroup ──
    mkdir /sys/fs/cgroup/memory/bg 0750 root system
    write /sys/fs/cgroup/memory/bg/memory.move_charge_at_immigrate 1
    chown root system /sys/fs/cgroup/memory/bg/tasks
    chmod 0660 /sys/fs/cgroup/memory/bg/tasks

    # WPSS
    write /sys/kernel/icnss/wpss_boot 1

    # Suspend mode
    write /sys/power/mem_sleep deep

    # CPU accounting
    mount cgroup none /acct cpuacct


# ─────────────────────────────────────────────────────────────
# post-fs
# ─────────────────────────────────────────────────────────────
on post-fs
    write /sys/class/graphics/fb0/idle_time 100


# ─────────────────────────────────────────────────────────────
# early-boot
# ─────────────────────────────────────────────────────────────
on early-boot
    setrlimit 8 67108864 67108864

    # ADSP boot is handled in init.target.rc
    write /sys/kernel/boot_cdsp/boot 1
    write /sys/devices/virtual/npu/msm_npu/boot 1

    setprop ro.sf.lcd_density ${persist.panel.density}
    setprop ro.alarm_boot false

    chown system graphics /sys/class/backlight/backlight/brightness
    chown system graphics /sys/class/backlight/backlight/max_brightness


# ─────────────────────────────────────────────────────────────
# boot
# ─────────────────────────────────────────────────────────────
on boot
    chmod 0444 /sys/devices/soc0/serial_number

    # Initial cpusets (post_boot.sh sets final values)
    write /dev/cpuset/background/cpus 0-3
    write /dev/cpuset/system-background/cpus 0-3
    write /dev/cpuset/restricted/cpus 0-3
    write /dev/cpuset/foreground/cpus 0-7
    write /dev/cpuset/top-app/cpus 0-7

    setprop vendor.post_boot.parsed 0

    # Bluetooth
    chown bluetooth bluetooth /sys/module/bluetooth_power/parameters/power
    chown bluetooth net_bt    /sys/class/rfkill/rfkill0/type
    chown bluetooth net_bt    /sys/class/rfkill/rfkill0/state
    chown bluetooth bluetooth /proc/bluetooth/sleep/proto
    chown bluetooth bluetooth /sys/module/hci_uart/parameters/ath_lpm
    chown bluetooth bluetooth /sys/module/hci_uart/parameters/ath_btwrite
    chown system    system    /sys/module/sco/parameters/disable_esco
    chown bluetooth bluetooth /sys/module/hci_smd/parameters/hcismd_set
    chown system    system    /sys/module/radio_iris_transport/parameters/fmsmd_set

    chmod 0660 /sys/module/bluetooth_power/parameters/power
    chmod 0660 /sys/module/hci_smd/parameters/hcismd_set
    chmod 0660 /sys/module/radio_iris_transport/parameters/fmsmd_set
    chmod 0660 /sys/class/rfkill/rfkill0/state
    chmod 0660 /proc/bluetooth/sleep/proto

    chown bluetooth net_bt /dev/ttyHS0
    chmod 0660 /dev/ttyHS0
    chmod 0660 /sys/module/hci_uart/parameters/ath_lpm
    chmod 0660 /sys/module/hci_uart/parameters/ath_btwrite

    chown bluetooth bluetooth /sys/devices/platform/msm_serial_hs.0/clock
    chmod 0660 /sys/devices/platform/msm_serial_hs.0/clock

    chmod 0660 /dev/ttyHS2
    chown bluetooth bluetooth /dev/ttyHS2

    chown bluetooth net_bt /sys/class/rfkill/rfkill0/device/extldo
    chmod 0660 /sys/class/rfkill/rfkill0/device/extldo

    # Audio
    chown media audio /sys/kernel/snd_card/card_state

    # Radio QMUX socket
    mkdir /dev/socket/qmux_radio 0770 radio radio
    chmod 2770 /dev/socket/qmux_radio

    # Persist directories (legacy + treble)
    mkdir /persist/drm 0770 system system
    mkdir /persist/bluetooth 0770 bluetooth bluetooth
    mkdir /persist/misc 0770 system system
    mkdir /persist/alarm 0770 system system
    mkdir /persist/display 0770 system graphics

    mkdir /mnt/vendor/persist/alarm     0777 system system
    chmod 0666 /mnt/vendor/persist/alarm/data
    mkdir /mnt/vendor/persist/drm       0770 system system
    mkdir /mnt/vendor/persist/bluetooth 0770 bluetooth bluetooth
    mkdir /mnt/vendor/persist/misc      0770 system system
    mkdir /mnt/vendor/persist/time      0770 system system
    mkdir /mnt/vendor/persist/secnvm    0770 system system
    mkdir /mnt/vendor/persist/iar_db    0770 system system
    mkdir /mnt/vendor/spunvm            0770 system system

    # Network
    setprop wifi.interface wlan0
    setprop ro.telephony.call_ring.multiple false
    chmod 0755 /system/bin/ip
    chmod 0444 /sys/devices/platform/msm_hsusb/gadget/usb_state
    setprop net.tcp.2g_init_rwnd 10
    write /proc/sys/net/netfilter/nf_conntrack_tcp_be_liberal 1

    chown system system /sys/module/ccid_bridge/parameters/bulk_msg_timeout

    # Display / media persist
    mkdir /mnt/vendor/persist/display    0770 system graphics
    mkdir /mnt/vendor/persist/vpp        0770 media media
    mkdir /mnt/vendor/persist/hvdcp_opti 0770 root system

    # Camera / WiFi / USB
    setprop persist.camera.gyro.disable 0
    chown wifi wifi /sys/module/wlan/parameters/fwpath
    setprop vendor.usb.rndis.func.name rndis_bam
    setprop vendor.usb.rmnet.func.name rmnet_bam
    setprop vendor.usb.rmnet.inst.name rmnet
    setprop vendor.usb.dpl.inst.name dpl
    setprop vendor.usb.qdss.inst.name qdss


# ─────────────────────────────────────────────────────────────
# post-fs-data
# ─────────────────────────────────────────────────────────────
on post-fs-data
    mkdir /data/vendor/misc            01771 system system
    mkdir /data/vendor/ssrdump         0770 root system
    mkdir /data/vendor/display         0770 system graphics
    mkdir /data/vendor/lm              0700 root root
    mkdir /data/vendor/media           0770 mediacodec media
    mkdir /data/vendor/tzstorage       0770 system system
    mkdir /data/vendor/qtee            0770 system system
    mkdir /data/vendor/camera          0770 camera camera
    mkdir /data/vendor/tombstones      0771 system system
    mkdir /data/vendor/tombstones/rfs  0771 system system
    mkdir /data/vendor/bluetooth       0770 bluetooth bluetooth
    mkdir /data/vendor/vpp             0770 media media
    mkdir /data/vendor/tui             0700 system drmrpc

    # Vibrator
    chown system system /sys/class/leds/vibrator/activate
    chown system system /sys/class/leds/vibrator/duration
    chown system system /sys/class/leds/vibrator/state
    chown system system /sys/class/leds/vibrator/vmax_mv
    chmod 0660 /sys/class/leds/vibrator/activate
    chmod 0660 /sys/class/leds/vibrator/duration
    chmod 0660 /sys/class/leds/vibrator/state
    chmod 0660 /sys/class/leds/vibrator/vmax_mv

    # WiFi directories
    mkdir /data/vendor/wifi                0770 wifi wifi
    mkdir /data/vendor/wifi/sockets        0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd        0770 wifi wifi
    mkdir /data/vendor/wifi/hostapd/ctrl   0770 wifi wifi
    mkdir /data/vendor/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa            0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets    0770 wifi wifi
    mkdir /data/vendor/connectivity        0771 radio radio
    chown radio radio /data/vendor/connectivity

    # Audio
    mkdir /data/vendor/audio                 0770 audio audio
    mkdir /data/vendor/audio/acdbdata        0770 media audio
    mkdir /data/vendor/audio/acdbdata/delta  0770 media audio

    # Radio
    mkdir /data/vendor/radio         0770 system radio
    rm /data/vendor/radio/shmbus
    mkdir /data/vendor/modem_config  0570 radio root

    # Persist chown
    chown root system /persist
    chmod 0771 /persist
    chown system system /persist/WCNSS_qcom_wlan_nv.bin

    # SD card polling
    chmod 0664 /sys/devices/platform/msm_sdcc.1/polling
    chmod 0664 /sys/devices/platform/msm_sdcc.2/polling
    chown system system /sys/devices/platform/msm_sdcc.1/polling
    chown system system /sys/devices/platform/msm_sdcc.2/polling

    # GPS / Location
    mkdir /data/vendor/location        0770 gps gps
    mkdir /data/vendor/location/mq     0770 gps gps
    mkdir /data/vendor/location/xtwifi 0770 gps gps
    mkdir /dev/socket/location         0770 gps gps
    mkdir /dev/socket/location/mq      0770 gps gps
    mkdir /dev/socket/location/xtra    0770 gps gps
    mkdir /dev/socket/location/ehub    0770 gps gps
    mkdir /dev/socket/location/dgnss   0770 gps gps

    # WiFi HAL socket
    mkdir /dev/socket/wifihal 0770 wifi wifi
    chmod 2770 /dev/socket/wifihal

    # Time / Secure / FM
    mkdir /data/vendor/time           0700 system system
    mkdir /data/vendor/secure_element 0777 system system
    mkdir /data/vendor/nfc            0770 nfc nfc
    mkdir /data/vendor/fm             0770 system system
    chmod 0770 /data/vendor/fm

    # Radio database
    write /data/vendor/radio/copy_complete 0
    chown radio radio /data/vendor/radio/copy_complete
    chmod 0660 /data/vendor/radio/copy_complete

    copy /vendor/radio/qcril_database/qcril.db /data/vendor/radio/qcril_prebuilt.db
    chown radio radio /data/vendor/radio/qcril_prebuilt.db
    chmod 0660 /data/vendor/radio/qcril_prebuilt.db

    write /data/vendor/radio/prebuilt_db_support 1
    chown radio radio /data/vendor/radio/prebuilt_db_support
    chmod 0400 /data/vendor/radio/prebuilt_db_support

    write /data/vendor/radio/db_check_done 0
    chown radio radio /data/vendor/radio/db_check_done
    chmod 0660 /data/vendor/radio/db_check_done

    # Swap
    mkdir /data/vendor/swap 0770 root system
    chmod 2770 /data/vendor/swap

    # eMMC + dm I/O tuning
    write /sys/block/mmcblk0/queue/rotational 0
    write /sys/block/mmcblk0/queue/iostats 0
    write /sys/block/mmcblk0/queue/add_random 0
    write /sys/block/mmcblk0/queue/nr_requests 128
    write /sys/block/mmcblk0/queue/rq_affinity 1
    write /sys/block/mmcblk0/queue/read_ahead_kb 1024

    write /sys/block/dm-0/queue/rotational 0
    write /sys/block/dm-0/queue/iostats 0
    write /sys/block/dm-0/queue/nr_requests 128
    write /sys/block/dm-0/queue/rq_affinity 1
    write /sys/block/dm-0/queue/read_ahead_kb 1024

    write /sys/block/dm-1/queue/rotational 0
    write /sys/block/dm-1/queue/iostats 0
    write /sys/block/dm-1/queue/nr_requests 128
    write /sys/block/dm-1/queue/rq_affinity 1
    write /sys/block/dm-1/queue/read_ahead_kb 1024

    write /sys/block/dm-2/queue/rotational 0
    write /sys/block/dm-2/queue/iostats 0
    write /sys/block/dm-2/queue/nr_requests 128
    write /sys/block/dm-2/queue/rq_affinity 1
    write /sys/block/dm-2/queue/read_ahead_kb 1024

    setprop vold.post_fs_data_done 1


# ─────────────────────────────────────────────────────────────
# property triggers
# ─────────────────────────────────────────────────────────────
on property:sys.boot_completed=1
    write /dev/kmsg "Boot completed"

    # Start post-boot tuning
    start vendor.qcom-post-boot

    # Read ahead back to normal
    write /sys/block/mmcblk0/queue/read_ahead_kb 128
    write /sys/block/dm-0/queue/read_ahead_kb 128
    write /sys/block/dm-1/queue/read_ahead_kb 128
    write /sys/block/dm-2/queue/read_ahead_kb 128

    # Audio / DSP nodes
    chown media audio /sys/kernel/wdsp0/boot
    chown media audio /sys/kernel/wcd_cpe0/fw_name
    chown media audio /sys/kernel/aud_dev/state
    write /sys/devices/virtual/cvp/cvp/boot 1

    # LPM
    write /sys/module/lpm_levels/parameters/sleep_disabled 0

on property:vendor.media.target.version=*
    setprop vendor.sys.media.target.version ${vendor.media.target.version}

on property:vendor.netflix.bsp_rev=*
    setprop ro.netflix.bsp_rev ${vendor.netflix.bsp_rev}

on property:vendor.media.target_variant=*
    setprop ro.media.xml_variant.codecs ${vendor.media.target_variant}
    setprop ro.media.xml_variant.codecs_performance ${vendor.media.target_variant}

on property:sys.sysctl.tcp_adv_win_scale=*
    write /proc/sys/net/ipv4/tcp_adv_win_scale ${sys.sysctl.tcp_adv_win_scale}

on property:ro.vendor.ril.mbn_copy_completed=1
    write /data/vendor/radio/copy_complete 1

on property:vendor.rild.libpath=*
    setprop rild.libpath ${vendor.rild.libpath}

on property:ro.vendor.radio.noril=*
    setprop ro.radio.noril ${ro.vendor.radio.noril}

on property:vendor.opengles.version=*
    setprop ro.opengles.version ${vendor.opengles.version}

on property:vendor.gpu.available_frequencies=*
    setprop ro.vendor.gpu.available_frequencies ${vendor.gpu.available_frequencies}

on property:sys.shutdown.requested=*
    write /sys/kernel/shutdown_wlan/shutdown 1
    stop cnss-daemon

on property:vold.decrypt=trigger_restart_framework
    start qcom-c_main-sh
    restart vendor.audio-hal


# ─────────────────────────────────────────────────────────────
# services
# ─────────────────────────────────────────────────────────────
service qcom-c_main-sh /vendor/bin/init.class_main.sh
    class main
    user root
    group root system
    oneshot

service vendor.qrtr-ns /vendor/bin/qrtr-ns -f
    class core
    user vendor_qrtr
    group vendor_qrtr
    capabilities NET_BIND_SERVICE
    task_profiles ServiceCapacityLow

service irsc_util /vendor/bin/irsc_util /vendor/etc/sec_config
    class core
    user root
    oneshot
    task_profiles ServiceCapacityLow

service cnss-daemon /vendor/bin/cnss-daemon -n -l
    class late_start
    user system
    group system inet net_admin wifi
    capabilities NET_ADMIN
    task_profiles ServiceCapacityLow

service ssgqmigd /vendor/bin/ssgqmigd
    class late_start
    user radio
    group radio gps system
    socket ssgqmig seqpacket 0660 radio inet

service mlid /vendor/bin/mlid
    class late_start
    user gps
    group gps
    socket mlid stream 0666 gps gps
    task_profiles ServiceCapacityLow

service vendor.hvdcp_opti /vendor/bin/hvdcp_opti
    class main
    user root
    group system wakelock

service loc_launcher /vendor/bin/loc_launcher
    class late_start
    user gps
    group gps
    task_profiles ServiceCapacityLow

service qcom-sh /vendor/bin/init.qcom.sh
    class late_start
    user root
    group root system radio
    oneshot

service vendor.qcom-post-boot /vendor/bin/init.qcom.post_boot.sh
    class late_start
    user root
    group root system wakelock graphics
    disabled
    oneshot

service hostapd_fst /vendor/bin/hw/hostapd -dd -g /data/vendor/wifi/hostapd/global
    class main
    capabilities NET_ADMIN NET_RAW
    user wifi
    group wifi
    disabled
    oneshot

service vendor.power_off_alarm /vendor/bin/power_off_alarm
    class core
    group system
    disabled
    oneshot

on charger
    start vendor.qcom-post-boot
    start vendor.hvdcp_opti
    start vendor.power_off_alarm
