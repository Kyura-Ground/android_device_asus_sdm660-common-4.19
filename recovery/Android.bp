soong_config_module_type {
    name: "asus_recovery_cc_defaults",
    module_type: "cc_defaults",
    config_namespace: "asus_recovery",
    bool_variables: ["uses_bootdevice_path"],
    properties: ["cflags"],
}

asus_recovery_cc_defaults {
    name: "asus_recovery_updater_defaults",
    soong_config_variables: {
        uses_bootdevice_path: {
            cflags: ["-DUSES_BOOTDEVICE_PATH"],
        },
    },
}

cc_library_static {
    name: "librecovery_updater_asus",
    defaults: ["asus_recovery_updater_defaults"],
    include_dirs: [
        "bootable/deprecated-ota/edify/include",
        "bootable/deprecated-ota/updater/include",
        "bootable/recovery",
        "bootable/recovery/otautil/include",
        "system/libbase/include",
    ],
    srcs: ["recovery_updater.cpp"],
}
